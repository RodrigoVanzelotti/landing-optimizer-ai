{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "json": {
            "()": "app.logging_utils.JsonFormatter"
        }
    },
    "handlers": {
        "default": {
            "class": "logging.StreamHandler",
            "formatter": "json",
            "stream": "ext://sys.stdout"
        }
    },
    "root": {
        "level": "INFO",
        "handlers": ["default"]
    },
    "loggers": {
        "app": {
            "level": "INFO",
            "handlers": ["default"],
            "propagate": false
        },
        "uvicorn": {
            "level": "INFO",
            "handlers": ["default"],
            "propagate": false
        },
        "uvicorn.error": {
            "level": "INFO",
            "handlers": ["default"],
            "propagate": false
        },
        "uvicorn.access": {
            "level": "INFO",
            "handlers": ["default"],
            "propagate": false
        }
    }
}